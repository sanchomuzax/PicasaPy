@echo off
setlocal enabledelayedexpansion
echo PicasaPy telepito - Windows
echo.

where py >nul 2>nul
if errorlevel 1 (
    echo HIBA: nem talalhato a "py" Python-inditoparancs.
    echo Telepitsd a Python 3.12+ -t innen: https://www.python.org/downloads/windows/
    echo Telepiteskor pipald be: "Add python.exe to PATH"
    pause
    exit /b 1
)

rem #3021: EGY ertelmezot valasztunk ki, es MINDENHOL azt hasznaljuk.
rem Korabban a pip-telepites tartalekkal probalkozott, a parancsikon utvonalait
rem viszont egy beegetett verziotol kerdeztuk meg - ha az a verzio eltunt a
rem geprol (pl. frissites utan), a telepites sikerult, a parancsikon viszont
rem neman elmaradt vagy a regi Scripts-mappara mutatott.
set "PYCMD="
for %%c in ("py -3" "python") do (
    if not defined PYCMD (
        %%~c -c "import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)" >nul 2>nul
        if not errorlevel 1 set "PYCMD=%%~c"
    )
)

if not defined PYCMD (
    echo HIBA: nem talalhato Python 3.12 vagy ujabb.
    echo Telepitsd innen: https://www.python.org/downloads/windows/
    pause
    exit /b 1
)
echo Hasznalt Python: !PYCMD!

echo Pip frissitese...
!PYCMD! -m pip install --upgrade pip

echo.
echo PicasaPy telepitese...
set FOUND=0
for %%f in ("%~dp0picasapy-__VERSION__-py3-none-any.whl") do (
    set FOUND=1
    !PYCMD! -m pip install --upgrade "%%f"
)

if "!FOUND!"=="0" (
    echo HIBA: nem talalhato a picasapy-__VERSION__-py3-none-any.whl fajl ebben a mappaban.
    pause
    exit /b 1
)

echo.
echo Parancsikonok letrehozasa (Asztal + Start menu)...
rem #67: talca-ikon - az .exe-hez tartozo parancsikon explicit IconLocation-t
rem kap (assets/icon.ico), igy a taskbar/Start-menu nem a Python-ikont mutatja.
rem A parancsikon MINDEN telepiteskor ujrairodik: Python-frissites utan a regi
rem a mar nem letezo Scripts-mappara mutatna.
set SCRIPTS_DIR=
for /f "delims=" %%p in ('!PYCMD! -c "import sysconfig; print(sysconfig.get_path('scripts'))" 2^>nul') do set SCRIPTS_DIR=%%p
set ICON_PATH=
for /f "delims=" %%p in ('!PYCMD! -c "import importlib.util, pathlib; s = importlib.util.find_spec('picasapy.app'); print(pathlib.Path(s.origin).parent / 'assets' / 'icon.ico')" 2^>nul') do set ICON_PATH=%%p

if defined SCRIPTS_DIR if defined ICON_PATH (
    set "TARGET_EXE=!SCRIPTS_DIR!\picasapy.exe"
    if exist "!TARGET_EXE!" if exist "!ICON_PATH!" (
        set "STARTMENU_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs"
        powershell -NoProfile -ExecutionPolicy Bypass -Command "$w = New-Object -ComObject WScript.Shell; foreach ($p in @('%USERPROFILE%\Desktop\PicasaPy.lnk', '!STARTMENU_DIR!\PicasaPy.lnk')) { $s = $w.CreateShortcut($p); $s.TargetPath = '!TARGET_EXE!'; $s.IconLocation = '!ICON_PATH!'; $s.WorkingDirectory = '!SCRIPTS_DIR!'; $s.Save() }"
        if errorlevel 1 (
            echo FIGYELEM: a parancsikonok letrehozasa nem sikerult, de a telepites folytatodik.
        ) else (
            echo Parancsikonok letrehozva: Asztal es Start menu.
        )
    ) else (
        echo FIGYELEM: picasapy.exe vagy icon.ico nem talalhato, parancsikon kimarad.
        echo Probald igy inditani: !PYCMD! -m picasapy.app
    )
) else (
    echo FIGYELEM: nem sikerult megallapitani a Scripts- vagy ikon-utvonalat, parancsikon kimarad.
)

echo.
echo Telepites kesz. Nyiss egy UJ parancssort, es probald ki: picasapy
pause
