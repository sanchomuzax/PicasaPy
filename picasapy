#!/usr/bin/env python3
"""PicasaPy indító — telepítés nélkül futtatható a repóból.

Használat: ./picasapy [könyvtár-gyökér...]
Gyökér nélkül a ~/.config/picasapy/WatchedFolders.txt-ből olvas.
"""

import sys
import time
from pathlib import Path

# #1601: a legelső saját sorunk — ebből látszik a PySide6-import ideje is az
# indulási idővonalon (`PICASAPY_STARTUP_TIMELINE=1`).
_ENTRY_AT = time.monotonic()

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from picasapy.app.application import run

if __name__ == "__main__":
    # #6374: a csomag belépője (`picasapy.app.__main__`) ezt korán kezeli; a repó
    # indítója közvetlenül a `run`-t hívná, és a teljes program indulna el.
    if "--qml-elofordit" in sys.argv[1:]:
        from picasapy.app.qml_precompile import main as qml_precompile_main

        sys.exit(qml_precompile_main())
    sys.exit(run(sys.argv, entry_at=_ENTRY_AT))
